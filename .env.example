# Supabase HTTP API Configuration
# By connecting via HTTPS to Supabase, we bypass direct TCP routing issues entirely.
SUPABASE_URL=https://yourprojectref.supabase.co
# Paste your Supabase Service Role Key (service_role API key starting with 'eyJ...') below:
SUPABASE_KEY=your_supabase_service_role_key_here

# User JWT Secret & Config
JWT_SECRET=your_jwt_signing_secret_for_users_minimum_32_characters

# Admin JWT Secret
ADMIN_JWT_SECRET=your_admin_jwt_signing_secret_minimum_32_characters

# Admin Credentials (Plain username + Bcrypt hash of password)
# For password: 'SecretAdminPassword123'
ADMIN_USERNAME=dating_admin
ADMIN_PASSWORD_HASH=$2b$12$Z0bOa3wG36DvxP7rWdK5fO/4R8P.Ww262zLwZ3Xf8h1o.3qK4kSXe

# Public URL of the app: allowed for CORS and used for the links in match emails
FRONTEND_URL=https://private-blind-dating.vercel.app

# Match notification emails (optional). Leave SMTP_HOST empty to turn them off.
# Any SMTP provider works, e.g. Brevo (smtp-relay.brevo.com) or Resend (smtp.resend.com).
# Render's free tier blocks outbound ports 25, 465 and 587: use 2525 (Brevo, Mailgun) or 2587 (Resend) there.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender users see; your provider must have verified this address or its domain
SMTP_FROM=Loom <matchmaker@yourdomain.com>
# TLS from the first byte instead of STARTTLS. Defaults to true only on port 465
# SMTP_USE_SSL=false
